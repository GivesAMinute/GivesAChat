{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "givesachat-cloudflare",
  "main": "src/index.js",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  "durable_objects": {
    "bindings": [
      {
        "name": "ChatRoom",
        "class_name": "ChatRoom"
      },
      {
        "name": "VeloraTokenStore",
        "class_name": "VeloraTokenStore"
      },
      {
        "name": "PopupRoom",
        "class_name": "PopupRoom"
      },
      {
        "name": "BeamRoom",
        "class_name": "BeamRoom"
      }
    ]
  },

  "exports": {
    "ChatRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "VeloraTokenStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PopupRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BeamRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  // Non-secret config only.
  // VELORA_CLIENT_SECRET is a Cloudflare secret, set with:
  //   npx wrangler secret put VELORA_CLIENT_SECRET
  // Never add it here — this file is committed to a public repo.
  "vars": {
    "VELORA_CLIENT_ID": "velora_45271c710e18820f",
    "VELORA_REDIRECT_URI": "https://givesachat-cloudflare.benonkoebsch.workers.dev/velora/callback"
  },

  "assets": {
    "directory": "../public",
    "binding": "ASSETS"
  },

  "workers_dev": true
}
