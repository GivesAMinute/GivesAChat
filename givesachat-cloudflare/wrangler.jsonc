{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "givesachat-cloudflare",
  "main": "src/index.js",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  "durable_objects": {
    "bindings": [
      {
        "name": "ChatRoom",
        "class_name": "ChatRoom"
      },
      {
        "name": "VeloraTokenStore",
        "class_name": "VeloraTokenStore"
      },
      {
        "name": "PopupRoom",
        "class_name": "PopupRoom"
      },
      {
        "name": "BeamRoom",
        "class_name": "BeamRoom"
      },
      {
        "name": "ArenaRoom",
        "class_name": "ArenaRoom"
      },
      {
        "name": "OdyseeRoom",
        "class_name": "OdyseeRoom"
      },
      {
        "name": "BitChuteRoom",
        "class_name": "BitChuteRoom"
      },
      {
        "name": "FacebookTokenStore",
        "class_name": "FacebookTokenStore"
      },
      {
        "name": "FacebookRoom",
        "class_name": "FacebookRoom"
      }
    ]
  },

  "exports": {
    "ChatRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "VeloraTokenStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PopupRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BeamRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ArenaRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "OdyseeRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BitChuteRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "FacebookTokenStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "FacebookRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },

    /* ---------------------------------------------------------
       Tombstone — VPZONE now arrives through Beam's relay.

       Deleting a Durable Object class is not just deleting the
       file. Cloudflare has a provisioned namespace for it, and
       removing the class from both code and this list leaves
       that namespace orphaned:

         [orphaned_provisioned_namespace] class 'VPZoneRoom' …
         is neither in code nor in `exports`

       This entry retires the namespace properly. It is the
       modern equivalent of a `deleted_classes` migration, and it
       stays here permanently — removing it would orphan the
       namespace all over again.
    --------------------------------------------------------- */
    "VPZoneRoom": {
      "type": "durable-object",
      "state": "deleted"
    }
  },

  // Non-secret config only.
  // VELORA_CLIENT_SECRET is a Cloudflare secret, set with:
  //   npx wrangler secret put VELORA_CLIENT_SECRET
  // Never add it here — this file is committed to a public repo.
  "vars": {
    "VELORA_CLIENT_ID": "velora_45271c710e18820f",
    "VELORA_REDIRECT_URI": "https://givesachat-cloudflare.benonkoebsch.workers.dev/velora/callback",

    // Used to fetch the channel's own subscription badge set from
    // /api/badges/channel/:username — months-based artwork, public,
    // no token needed.
    "VELORA_CHANNEL": "GivesAMinute",

    // Used by /api/velora/reward-sounds, which proxies Velora's
    // channel-points endpoint because they no longer send CORS
    // headers and the browser refuses the response.
    "VELORA_CHANNEL_ID": "4f1cb975-eace-4650-8246-053007bd0036",

    // Blaze — Client ID is public; the secret is a Cloudflare
    // secret (npx wrangler secret put BLAZE_CLIENT_SECRET)
    "BLAZE_CLIENT_ID": "SIQ6qp4IcEVM6D6TBWLousZQY0VrCLQC",
    "BLAZE_CHANNEL_ID": "f6b81529-8fcd-4bbe-b2b7-8f6d9c99b15f",

    // Arena (arena.social) — public endpoints, no credential
    "ARENA_HANDLE": "GivesAMinute",

    // VPZONE now arrives via Beam's relay, so there is no socket
    // and no channel to configure. VPZONE_API_KEY (secret) is
    // still used, by vpzoneAvatars.js — Beam relays VPZONE with
    // avatarUrl: null, so the picture is looked up per user.

    // Odysee — public endpoints, no credential.
    //
    // This is the CHANNEL claim id, which never changes. The
    // per-stream claim id the chat socket actually needs is
    // discovered at runtime from api.odysee.live, because it is
    // different for every stream.
    "ODYSEE_CHANNEL_CLAIM_ID": "2e4c63a39e28e8e2bcac74debece9f7893fc3fe5",

    // BitChute — anonymous read, no credential.
    //
    // The chat socket is keyed to the CHANNEL (x7gWP4Vw8CXN),
    // which is why no per-stream lookup is needed. But the signed
    // cf_auth token has to be fetched from a pop-out page, and
    // that page is per-VIDEO.
    //
    // If this id turns out to change every broadcast, it becomes
    // the Odysee problem again and needs resolving at runtime —
    // check /bitchute/token after the next stream starts.
    "BITCHUTE_VIDEO_ID": "Oxf29kKWYoS7",

    // Facebook — public app id, safe in the repo. The app SECRET
    // is a wrangler secret and must never appear here.
    //
    // FACEBOOK_OWNER_ID pins which account may connect, which is
    // what lets /facebook/connect stay unprotected: the URL is
    // opened directly from a browser, and a key in a URL leaks
    // into history, referrers and proxy logs. A stranger who
    // finds the link authorises their own account and is
    // rejected at the callback.
    //
    // App-scoped, so it is meaningless outside this one app —
    // and it CHANGES when the app changes. This is the second
    // app: the first could not host the Live Video API use case
    // alongside Facebook Login, which is why profile streaming
    // could never have worked on it.
    //
    "FACEBOOK_APP_ID": "2575242256241936",
    "FACEBOOK_OWNER_ID": "10162724753141073",

    // Which Pages we hold tokens for. Authorising returns one for
    // every Page the account administers — eleven here — and those
    // tokens never expire, so unlisted ones are discarded at save
    // time rather than stored and ignored.
    //
    // Comma-separated. Adding one needs a reconnect as well as a
    // deploy; /facebook/status will say so if you forget.
    //
    //   108984299449293  Gives A Minute
    "FACEBOOK_PAGE_IDS": "108984299449293"
  },

  /* Every two minutes. Cron ticks are WORKER requests, not Durable
     Object duration, so the supervisor itself is effectively free —
     the whole point is that nothing expensive runs while offline.
     Two minutes bounds how long chat can lag the start of a stream. */
  "triggers": {
    "crons": ["*/2 * * * *"]
  },

  "assets": {
    "directory": "../public",
    "binding": "ASSETS"
  },

  "workers_dev": true
}
